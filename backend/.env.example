# TripMate AI — Backend Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.

PORT=8000
HOST=127.0.0.1
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=tripmate_db

# JWT Configuration (generate a secure random signing key)
JWT_SECRET=your_super_secret_jwt_key_generate_random_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local Generative AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# CORS Whitelist (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Weather Provider
# Real-time weather dynamically queried via Open-Meteo REST API (no API key required)
WEATHER_PROVIDER=open-meteo
