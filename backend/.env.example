# TripMate AI — Backend Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.

PORT=8000
HOST=127.0.0.1
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=tripmate_db

# JWT Configuration
JWT_SECRET=generate_a_secure_random_signing_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Services
OPENAI_API_KEY=your_openai_api_key_here

# Weather Provider
# Open-Meteo does not require an API key by default, but a place-holder key can be specified
WEATHER_API_KEY=not_required_for_open_meteo
